# CORS and API Auth
API_AUTH_TOKEN=your_secure_random_token_here
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Model & Backend Selection (Ollama defaults shown below)
# For Ollama (local, air-gapped, recommended):
#   1. Download Ollama: https://ollama.ai
#   2. Pull a model: ollama pull qwen2.5-coder:7b
#   3. Run: ollama serve
#
# Model selection:
# - qwen2.5-coder:7b (default): Good balance of quality vs speed on 16GB RAM
# - qwen3-coder:7b (if available): Newer, potentially better quality (~2026+)
# - llama2-34b: Larger, slower, but higher quality
# - mistral:7b: Faster, lower quality
#
# To benchmark different models, run:
#   python tests/benchmark_models.py
#
# For NVIDIA NIM or OpenAI, see .env.example comments below.

WORKFLOW_MODEL_PROVIDER=openai

# ── Ollama (Air-Gapped, Local) ────────────────────────────────────
# Ensure: ollama serve is running on localhost:11434
OPENAI_ENDPOINT_BASE=http://localhost:11434/v1
OPENAI_MODELS=qwen2.5-coder:7b
API_KEY=ollama

# ── OR: NVIDIA NIM (Cloud, Free Tier Available) ───────────────────
# Uncomment and fill in your API key to use NVIDIA NIM instead
# OPENAI_ENDPOINT_BASE=https://integrate.api.nvidia.com/v1
# OPENAI_MODELS=meta/llama3-70b-instruct
# API_KEY=nvapi-xxxx

# ── OR: OpenAI ────────────────────────────────────────────────────
# Uncomment and fill in your API key to use OpenAI API
# OPENAI_ENDPOINT_BASE=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o
# API_KEY=sk-xxxx

# Compiler & Verification Settings
# COMPILER_PATH should only be set if auto-detection of g++/clang++ fails.
# It must point directly to the compiler executable (e.g., /usr/bin/g++ or C:\path\to\cl.exe), NOT a directory.
# COMPILER_PATH=
SKIP_VERIFICATION=0              # Set to 1 to skip compilation checks
CPP_STANDARD=c++17               # Target C++ standard (c++14/17/20/23)

# Modernization Pipeline Settings
LLM_TEMPERATURE=0.1              # Model temperature (0.0 = deterministic, 1.0 = random)
USE_CACHE=1                      # Cache LLM responses to speed up re-runs
CACHE_TTL_SECONDS=604800         # 7 days — cache expires after this
ENABLE_REFLECTION=0              # Disable reflection to save 1 LLM call per file
REFLECTION_MAX_ITERS=1           # Max reflection iterations
ENABLE_RAG=0                     # Disable RAG (rules handle pattern lookup)
WORKFLOW_MIN_SCORE_DELTA=5       # Minimum improvement required
MODERN_RETRY_THRESHOLD_PERCENT=50
MODERNIZER_CHUNK_MAX_CHARS=3000  # ~100 lines per chunk

# Batch Processing
WORKFLOW_BATCH_SIZE=1            # Files processed per job
MAX_WORKERS=2                    # Parallel workers (for multi-file projects)

# Langfuse Tracing (Optional)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend API Configuration (Optional)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/modernize

# Redis configuration for rate limiting across multiple workers
REDIS_URL=redis://localhost:6379/0

SEMANTIC_GUARD_LENIENT=1
